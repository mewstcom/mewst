package layouts

import (
	"github.com/a-h/templ"
	"github.com/mewstcom/mewst/go/internal/session"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
	"github.com/mewstcom/mewst/go/internal/viewmodel"
)

// DefaultLayoutData holds the data passed to the authenticated shared layout.
// Navbar carries the current user's atname and the active menu item.
//
// [Ja] 認証後ページ共通レイアウトに渡すデータ構造体。Navbar は現在ユーザーの
// atname とアクティブなメニュー項目を保持する。
type DefaultLayoutData struct {
	Meta   viewmodel.PageMeta
	Navbar viewmodel.Navbar
}

// Default is the shared layout for authenticated pages: head, top navbar, main
// content, shared footer, and the mobile bottom navbar.
//
// [Ja] 認証後ページの共通レイアウト。head・トップ navbar・main コンテンツ・
// 共通フッター・モバイル用ボトム navbar で構成する。
templ Default(data DefaultLayoutData, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(data.Meta)
		</head>

		<body>
			@components.SkipLink()
			@components.Flash(session.FlashFromContext(ctx))

			// Keep shared navigation and page content inside the top and side safe areas.
			// The inset variables resolve to zero on displays without constrained edges.
			//
			// [Ja] 共通ナビゲーションとページ内容を上・左右の safe area 内に収める。
			// 制約のない画面では inset 変数が 0 になり、従来の配置を維持する。
			<div class="flex min-h-[100svh] flex-col pt-safe px-safe">
				@components.TopNavbar(data.Navbar)

				<main id="main" tabindex="-1" class="flex-1 pb-safe">
					@content
				</main>

				// Keep the shared footer clear of the mobile bottom navbar pill. On lg the
				// pill is hidden, so a small margin suffices. The layout owns this
				// placement-specific spacing so BasicFooter remains independent of it.
				//
				// [Ja] 共通フッターとモバイルのボトム navbar ピルが重ならないようにする。
				// lg ではピルが非表示になるため小さいマージンで足りる。配置固有の余白は
				// レイアウト側に持たせ、BasicFooter を余白から独立させる。
				<div class="mb-[100px] lg:mb-4">
					@components.BasicFooter()
				</div>

				// Pin the bottom navbar to the bottom-center on mobile (the component itself hides it on lg).
				// mb-safe lifts the pill above the home indicator in standalone mode. Its margin and
				// the horizontal safe-area padding are additive to the existing 1rem inset; safe-area
				// values resolve to zero where no constrained edge exists.
				//
				// [Ja] モバイルではボトム navbar を画面下部中央に固定する (lg ではコンポーネント側で非表示)。
				// mb-safe はスタンドアロン表示でピルをホームインジケータの上へ持ち上げる。margin と左右の
				// safe-area padding は既存の 1rem の余白に加算され、制約のない辺では値が 0 になる。
				<div class="fixed bottom-0 left-1/2 z-50 -translate-x-1/2 py-4 px-safe-offset-4 mb-safe lg:hidden">
					@components.BottomNavbar(data.Navbar)
				</div>
			</div>
		</body>
	</html>
}
