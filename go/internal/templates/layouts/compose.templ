package layouts

import (
	"github.com/a-h/templ"
	"github.com/mewstcom/mewst/go/internal/session"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
	"github.com/mewstcom/mewst/go/internal/viewmodel"
)

// ComposeLayoutData holds the data passed to the compose layout. BackHref is the
// fallback destination for the back affordance (the back-link script upgrades it
// to history.back() when the referrer is same-origin).
//
// [Ja] ComposeLayoutData は compose レイアウトに渡すデータ構造体。BackHref は戻る
// 導線のフォールバック先 (referrer が同一オリジンのとき back-link スクリプトが
// history.back() に格上げする)。
type ComposeLayoutData struct {
	Meta     viewmodel.PageMeta
	BackHref templates.Path
}

// Compose is the layout for modal-like focused pages served as their own full
// page (e.g. the new post form). It hides the navbar to keep the user on a single
// task, centers the content, and pins a back affordance to the top-left corner —
// reproducing the "close and return" feel of the Rails turbo-frame modal without
// an actual overlay.
//
// [Ja] Compose はモーダル風だが独立したフルページとして配信する集中作成画面 (新規
// 投稿フォーム等) 用のレイアウト。navbar を隠してユーザーを単一タスクに集中させ、
// コンテンツを中央に寄せ、戻る導線を左上端に固定する。Rails の turbo-frame モーダル
// の「閉じて元に戻る」体験を、実際のオーバーレイ無しで再現する。
templ Compose(data ComposeLayoutData, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(data.Meta)
		</head>

		<body class="flex min-h-[100svh] items-center justify-center p-4">
			@components.Flash(session.FlashFromContext(ctx))

			// Back affordance pinned to the window's top-left corner, outside the
			// centered flow. The href is a fallback for direct visits, external
			// referrers, or JS-disabled clients (progressive enhancement); the
			// back-link script upgrades it to history.back() when the referrer is
			// same-origin.
			//
			// [Ja] 中央寄せフローの外側、ウィンドウ左上端に固定する戻る導線。href は
			// 直接アクセス・外部からの遷移・JS 無効時のフォールバック (プログレッシブ
			// エンハンスメント) で、referrer が同一オリジンのときは back-link
			// スクリプトが history.back() に格上げする。
			<div class="fixed left-4 top-4 z-50">
				<a class="link-muted" data-back-link href={ data.BackHref }>
					{ templates.T(ctx, "compose_back") }
				</a>
			</div>

			@content
		</body>
	</html>
}
