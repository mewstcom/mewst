package sign_in

import (
	"github.com/mewstcom/mewst/internal/session"
	"github.com/mewstcom/mewst/internal/templates"
	"github.com/mewstcom/mewst/internal/templates/components"
)

// NewPageData はログインフォームページのデータ
type NewPageData struct {
	CSRFToken       string
	TurnstileSiteKey string
	FormErrors      *session.FormErrors
	Email           string
}

// New はログインフォームを表示する
templ New(data NewPageData) {
	<div class="flex flex-col gap-6 min-w-full md:min-w-md px-4">
		<div class="text-center">
			<a href="/" class="inline-block">
				<div class="bg-(--primary) rounded-xl">
					@templates.Icon("logo", "fill-black w-[60px] h-[60px]")
				</div>
			</a>
		</div>

		<div class="flex flex-col gap-2">
			<h1 class="text-center text-3xl font-bold">
				{ templates.T(ctx, "sign_in_title") }
			</h1>
		</div>

		@components.FormErrors(data.FormErrors)

		<form method="POST" action="/sign_in" class="grid gap-6">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

			<div class="grid gap-2">
				<label for="email">
					{ templates.T(ctx, "label_email") }
				</label>
				<input
					if data.FormErrors != nil && data.FormErrors.Fields["email"] != nil {
						aria-invalid="true"
					} else {
						aria-invalid="false"
					}
					type="email"
					id="email"
					name="email"
					autocomplete="username"
					autofocus
					required
					tabindex="1"
					value={ data.Email }
				/>
				if data.FormErrors != nil && data.FormErrors.Fields["email"] != nil {
					for _, errorMsg := range data.FormErrors.Fields["email"] {
						<p class="text-sm text-red-600">{ errorMsg }</p>
					}
				}
			</div>

			<div class="grid gap-2">
				<div class="flex items-center justify-between">
					<label for="password">
						{ templates.T(ctx, "label_password") }
					</label>
					<a class="link text-sm" href="/password_reset" tabindex="4">
						{ templates.T(ctx, "password_reset_title") }
					</a>
				</div>
				<input
					if data.FormErrors != nil && data.FormErrors.Fields["password"] != nil {
						aria-invalid="true"
					} else {
						aria-invalid="false"
					}
					type="password"
					id="password"
					name="password"
					autocomplete="current-password"
					required
					tabindex="2"
				/>
				if data.FormErrors != nil && data.FormErrors.Fields["password"] != nil {
					for _, errorMsg := range data.FormErrors.Fields["password"] {
						<p class="text-sm text-red-600">{ errorMsg }</p>
					}
				}
			</div>

			@components.Turnstile(data.TurnstileSiteKey)

			<button class="btn rounded-full w-fit" tabindex="3" type="submit">
				@templates.Icon("sign-in")
				{ templates.T(ctx, "btn_sign_in") }
			</button>
		</form>

		<div class="text-center text-muted-foreground">
			{ templates.T(ctx, "sign_in_no_account") }
			{ " " }
			<a class="link" href="/sign_up">
				{ templates.T(ctx, "sign_up_title") }
			</a>
		</div>
	</div>
}
