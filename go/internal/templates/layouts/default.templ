package layouts

import (
	"github.com/a-h/templ"
	"github.com/mewstcom/mewst/go/internal/session"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
	"github.com/mewstcom/mewst/go/internal/viewmodel"
)

// DefaultLayoutDataは認証後ページ共通レイアウトに渡すデータ構造体。Navbarは現在ユーザーの
// atnameとアクティブなメニュー項目を保持する。
type DefaultLayoutData struct {
	Meta   viewmodel.PageMeta
	Navbar viewmodel.Navbar
}

// Defaultは認証後ページの共通レイアウト。head・トップnavbar・mainコンテンツ・
// 共通フッター・モバイル用ボトムnavbarで構成する。
templ Default(data DefaultLayoutData, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(data.Meta)
		</head>

		<body>
			@components.SkipLink()
			@components.Flash(session.FlashFromContext(ctx))

			// 共通ナビゲーションとページ内容を上・左右のsafe area内に収める。
			// 制約のない画面ではinset変数が0になり、従来の配置を維持する。
			<div class="flex min-h-[100svh] flex-col pt-safe px-safe">
				@components.TopNavbar(data.Navbar)

				<main id="main" tabindex="-1" class="flex-1 pb-safe">
					@content
				</main>

				// 共通フッターとモバイルのボトムnavbarピルが重ならないようにする。
				// lgではピルが非表示になるため小さいマージンで足りる。配置固有の余白は
				// レイアウト側に持たせ、BasicFooterを余白から独立させる。
				<div class="mb-[100px] lg:mb-4">
					@components.BasicFooter()
				</div>

				// モバイルではボトムnavbarを画面下部中央に固定する (lgではコンポーネント側で非表示)。
				// mb-safeはスタンドアロン表示でピルをホームインジケータの上へ持ち上げる。marginと左右の
				// safe-area paddingは既存の1remの余白に加算され、制約のない辺では値が0になる。
				<div class="fixed bottom-0 left-1/2 z-50 -translate-x-1/2 py-4 px-safe-offset-4 mb-safe lg:hidden">
					@components.BottomNavbar(data.Navbar)
				</div>
			</div>
		</body>
	</html>
}
