package email_confirmation

// JaHTML は日本語版のメール確認 (HTML形式) です
templ JaHTML(email, code string) {
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>確認用コード</title>
		</head>
		<body style="font-family: sans-serif; line-height: 1.6; color: #333; padding: 20px;">
			<p>{ email } さん、こんにちは。</p>
			<p>確認用コードは下記になります。</p>
			<p style="font-size: 24px; font-weight: bold; letter-spacing: 4px;">{ code }</p>
			<p>確認用コードの有効期間は15分です。</p>
			<p>もしこのメールに心当たりが無い場合は無視してください。</p>
			<hr style="border: none; border-top: 1px solid #ccc; margin: 20px 0;"/>
			<p style="color: #666; font-size: 12px;">
				Mewst<br/>
				<a href="https://mewst.com" style="color: #666;">https://mewst.com</a>
			</p>
		</body>
	</html>
}
