# In Rack/CGI, Content-Type and Content-Length are stored without the
# HTTP_ prefix. All other headers use the HTTP_ prefix convention.
#
# pkg:gem/committee#lib/committee/test/except_parameter.rb:164
Committee::Test::ExceptParameter::HeaderHandler::SPECIAL_RACK_HEADERS = T.let(T.unsafe(nil), Hash)

