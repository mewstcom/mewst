package components

import "github.com/mewstcom/mewst/go/internal/viewmodel"

// LinkCardはリンクカード (ドメイン + タイトル + 任意のOGP画像) を描画する。
// RailsのCards::LinkCardComponentに対応する。
templ LinkCard(link viewmodel.Link) {
	<div class="flex rounded-lg border border-gray-300 p-2">
		<div class="flex w-full flex-col gap-2">
			if link.ImageURL != "" {
				// OGP画像は装飾扱いとしてaltを空にする。リンク先の情報はドメインと
				// タイトルのテキストで伝わるため。
				<img
					alt=""
					class="aspect-video max-h-[300px] object-contain w-full"
					height="9"
					loading="lazy"
					src={ link.ImageURL }
					width="16"
				/>
			}
			<div class="flex flex-col gap-1">
				<div class="text-sm text-gray-500">
					{ link.Domain }
				</div>
				<div class="font-bold">
					{ link.Title }
				</div>
			</div>
		</div>
	</div>
}
