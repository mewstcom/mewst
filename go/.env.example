# Mewst Go版 環境変数サンプル
# このファイルをコピーして .env を作成し、実際の値を設定してください
# cp .env.example .env

# データベース接続URL（必須）
DATABASE_URL=postgres://postgres:password@postgresql:5432/mewst_development?sslmode=disable

# サーバー設定
MEWST_PORT=3000
MEWST_DOMAIN=localhost
MEWST_COOKIE_DOMAIN=localhost

# セッション設定
MEWST_SESSION_SECURE=false
MEWST_SESSION_HTTPONLY=true

# Rails版アプリのURL（リバースプロキシ用、オプショナル）
MEWST_RAILS_APP_URL=http://rails-app:3000

# Cloudflare Turnstile（Bot対策、オプショナル）
MEWST_TURNSTILE_SITE_KEY=
MEWST_TURNSTILE_SECRET_KEY=

# Rate Limiting設定（開発環境ではtrueで無効化）
MEWST_DISABLE_RATE_LIMIT=true

# メンテナンスモード（"on" で有効、オプショナル）
MEWST_MAINTENANCE_MODE=

# 管理者IP（メンテナンスモード時にアクセスを許可するIP、カンマ区切り、オプショナル）
MEWST_ADMIN_IP=
