# Deserializes request parameters based on OpenAPI 3 parameter style and explode settings
#
# @see https://swagger.io/docs/specification/serialization/
# @see https://spec.openapis.org/oas/latest.html#parameter-object
#
# pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:12
class Committee::SchemaValidator::OpenAPI3::ParameterDeserializer
  # @param [OpenAPIParser::RequestOperation] request_operation
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:14
  def initialize(request_operation); end

  # Deserialize header parameters
  # @param [Hash] raw_headers Raw headers
  # @return [Hash] Deserialized headers according to OpenAPI schema
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:36
  def deserialize_headers(raw_headers); end

  # Deserialize path parameters
  # @param [Hash] raw_params Raw path parameters
  # @return [Hash] Deserialized parameters according to OpenAPI schema
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:29
  def deserialize_path_params(raw_params); end

  # Deserialize query parameters
  # @param [Hash] raw_params Raw query parameters from Rack
  # @return [Hash] Deserialized parameters according to OpenAPI schema
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:22
  def deserialize_query_params(raw_params); end

  private

  # Collect object properties from separate parameters (form explode=true)
  # @param [OpenAPIParser::Schemas::Schema] schema
  # @param [Hash] raw_params
  # @param [String] param_name Original parameter name (not used in exploded form)
  # @return [Hash, nil] Collected object properties
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:288
  def collect_object_properties(schema, raw_params, param_name); end

  # Convert a hash to an indifferent hash (supports both string and symbol keys)
  # @param [Hash] hash
  # @return [Committee::Utils::IndifferentHash]
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:105
  def convert_to_indifferent_hash(hash); end

  # Get default explode setting for a style
  # @param [String] style Parameter style
  # @return [Boolean] Default explode value
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:217
  def default_explode(style); end

  # Get default style for a parameter location
  # @param [String] location Parameter location
  # @return [String] Default style
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:203
  def default_style(location); end

  # Deserialize deep object style (query parameters only)
  # Example: ?filter[role]=admin&filter[status]=active → { filter: { role: "admin", status: "active" } }
  # @param [OpenAPIParser::Schemas::Parameter] param_def
  # @param [Hash] raw_params
  # @return [Hash, nil] Deserialized object
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:326
  def deserialize_deep_object(param_def, raw_params); end

  # Deserialize form-style array
  # @param [String] param_name
  # @param [OpenAPIParser::Schemas::Schema] schema
  # @param [Hash] raw_params
  # @param [Boolean] explode
  # @return [Array, nil] Deserialized array
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:268
  def deserialize_form_array(param_name, schema, raw_params, explode); end

  # Deserialize form-style object
  # @param [String] param_name
  # @param [OpenAPIParser::Schemas::Schema] schema
  # @param [Hash] raw_params
  # @param [Boolean] explode
  # @return [Hash, nil] Deserialized object
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:249
  def deserialize_form_object(param_name, schema, raw_params, explode); end

  # Deserialize form style parameter
  # Default for query and cookie parameters
  # @param [OpenAPIParser::Schemas::Parameter] param_def
  # @param [Hash] raw_params
  # @param [Boolean] explode
  # @return [Object] Deserialized value
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:227
  def deserialize_form_style(param_def, raw_params, explode); end

  # Deserialize label style (path parameters)
  # @param [OpenAPIParser::Schemas::Parameter] param_def
  # @param [Hash] raw_params
  # @param [Boolean] explode
  # @return [Object] Deserialized value
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:378
  def deserialize_label_style(param_def, raw_params, explode); end

  # Deserialize matrix style (path parameters)
  # @param [OpenAPIParser::Schemas::Parameter] param_def
  # @param [Hash] raw_params
  # @param [Boolean] explode
  # @return [Object] Deserialized value
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:416
  def deserialize_matrix_style(param_def, raw_params, explode); end

  # Deserialize parameters for a specific location (query, path, header)
  # @param [Hash] raw_params Raw parameters
  # @param [String] location Parameter location ('query', 'path', 'header')
  # @return [Hash] Deserialized parameters
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:46
  def deserialize_params_by_location(raw_params, location); end

  # Deserialize pipe-delimited style (query parameters, arrays only)
  # @param [OpenAPIParser::Schemas::Parameter] param_def
  # @param [Hash] raw_params
  # @param [Boolean] explode
  # @return [Array, nil] Deserialized array
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:527
  def deserialize_pipe_delimited(param_def, raw_params, explode); end

  # Deserialize simple style (path and header parameters)
  # @param [OpenAPIParser::Schemas::Parameter] param_def
  # @param [Hash] raw_params
  # @param [Boolean] explode
  # @return [Object] Deserialized value
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:347
  def deserialize_simple_style(param_def, raw_params, explode); end

  # Deserialize space-delimited style (query parameters, arrays only)
  # @param [OpenAPIParser::Schemas::Parameter] param_def
  # @param [Hash] raw_params
  # @param [Boolean] explode
  # @return [Array, nil] Deserialized array
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:513
  def deserialize_space_delimited(param_def, raw_params, explode); end

  # Extract and deserialize a single parameter
  # @param [OpenAPIParser::Schemas::Parameter] param_def Parameter definition
  # @param [Hash] raw_params Raw parameters
  # @return [Object] Deserialized value
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:173
  def extract_and_deserialize(param_def, raw_params); end

  # Extract matrix-style array (explode=false)
  # @param [String] value Matrix-style string
  # @param [String] param_name Parameter name
  # @return [Array] Extracted array
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:452
  def extract_matrix_array_compact(value, param_name); end

  # Extract matrix-style object (explode=false)
  # @param [String] value Matrix-style string
  # @param [String] param_name Parameter name
  # @return [Hash] Extracted object
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:484
  def extract_matrix_object_compact(value, param_name); end

  # Extract matrix-style object (explode=true)
  # @param [String] value Matrix-style string
  # @param [String] param_name Parameter name
  # @return [Hash] Extracted object
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:466
  def extract_matrix_object_exploded(value, param_name); end

  # Extract matrix-style primitive value
  # @param [String] value Matrix-style string
  # @param [String] param_name Parameter name
  # @return [String] Extracted value
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:498
  def extract_matrix_primitive(value, param_name); end

  # @param [Hash] result
  # @param [String] prefix
  # @param [Object] value
  # @return [void]
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:158
  def flatten_nested_query_param(result, prefix, value); end

  # Normalize Rack-style nested query hashes into bracket notation when the
  # schema expects bracket-named params or deepObject query params.
  # Example: { "filter" => { "slug" => "/test" } } => { "filter[slug]" => "/test" }
  # @param [Hash] raw_params
  # @param [String] location
  # @param [Array<OpenAPIParser::Schemas::Parameter>] params_for_location
  # @return [Hash]
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:117
  def normalize_raw_params(raw_params, location, params_for_location); end

  # Parse comma-separated object (form explode=false)
  # Example: "role,admin,status,active" → { "role" => "admin", "status" => "active" }
  # @param [String] value Comma-separated string
  # @return [Hash] Parsed object
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:308
  def parse_comma_separated_object(value); end

  # Parse key-value pairs with custom delimiters
  # @param [String] value String containing key-value pairs
  # @param [String] pair_delimiter Delimiter between pairs
  # @param [String] kv_delimiter Delimiter between key and value
  # @return [Hash] Parsed object
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:541
  def parse_key_value_pairs(value, pair_delimiter, kv_delimiter); end

  # @param [Array<OpenAPIParser::Schemas::Parameter>] params_for_location
  # @return [Boolean]
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:137
  def requires_query_param_flattening?(params_for_location); end

  # @param [String, Symbol] key
