  def apply(param_names); end

  # Restore original parameter values
  # @return [void]
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:136
  def restore; end

  private

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:153
  def dummy_value_for(key); end

  # Override in subclasses to specify the storage location
  # @return [Hash, nil]
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:149
  def get_storage; end
end

# Handler for request body parameters
#
# Supports three content types:
# - application/json (and variants): replaces rack.input stream so that
#   request_unpack re-parses the modified body during validation.
# - application/x-www-form-urlencoded / multipart/form-data: pre-populates
#   rack.request.form_hash, which Rack returns directly from request.POST
#   without re-parsing the raw body.
# - Other content types (e.g. binary): no-op, as RequestUnpacker does not
#   extract named parameters from them.
#
# pkg:gem/committee#lib/committee/test/except_parameter.rb:227
class Committee::Test::ExceptParameter::BodyHandler
  include ::Committee::Test::ExceptParameter::StringDummyLookup

  # @param [Rack::Request] request The request object
  # @param [Hash] committee_options Committee options hash
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:232
  def initialize(request, committee_options); end

  # Apply dummy values to body parameters based on content type.
  # @param [Array<String, Symbol>] param_names Body parameter names to except
  # @return [void]
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:242
  def apply(param_names); end

  # Restore original body content
  # @return [void]
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:253
  def restore; end

  private

  # --- Form body handling ---
  #
  # Calls request.POST to trigger Rack's form parsing (populating
  # rack.request.form_hash from rack.input), then injects dummy values
  # for missing params into the live hash. In Rack 3.x, request.POST
  # returns rack.request.form_hash directly on subsequent calls, so the
  # injected values are visible during validation.
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:313
  def apply_form(param_names); end

  # --- JSON body handling ---
  #
  # Replaces rack.input with a modified JSON body. Also clears any stale
  # rack.request.form_hash / rack.request.form_pairs caches so that Rack
  # does not return outdated form data if POST is called after the swap.
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:276
  def apply_json(param_names); end

  # --- Dummy value helpers ---
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:340
  def body_hash_key; end

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:399
  def body_param_schema(key); end

  # Returns a native-typed dummy value for JSON bodies.
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:364
  def dummy_value_for(key); end

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:265
  def form_content_type?; end

  # Returns a string-encoded dummy value for form bodies.
  # Form data is always transmitted as strings; openapi_parser's coerce_value
  # handles conversion to the declared type during validation.
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:384
  def form_dummy_for(key); end

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:260
  def json_content_type?; end

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:353
  def parse_body(body_str); end

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:344
  def read_body; end

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:359
  def replace_body(body_str); end

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:329
  def restore_form; end

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:298
  def restore_json; end
end

# pkg:gem/committee#lib/committee/test/except_parameter.rb:8
Committee::Test::ExceptParameter::FORMAT_DUMMIES = T.let(T.unsafe(nil), Hash)

# Handler for request headers
#
# pkg:gem/committee#lib/committee/test/except_parameter.rb:159
class Committee::Test::ExceptParameter::HeaderHandler
  include ::Committee::Test::ExceptParameter::StringDummyLookup

  # @param [Rack::Request] request The request object
  # @param [Hash] committee_options Committee options hash
