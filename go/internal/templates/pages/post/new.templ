package post

import (
	"strconv"

	"github.com/mewstcom/mewst/go/internal/model"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
	"github.com/mewstcom/mewst/go/internal/viewmodel"
)

// NewPageDataは新規投稿フォームページのデータを保持する。
type NewPageData struct {
	CSRFToken string
	// FormErrorsは送信失敗後に再表示するバリデーションエラー (初回表示時はnil)。
	FormErrors *model.ValidationError
	// Contentは送信した本文をエコーバックし、送信失敗時に入力を保持する。
	Content string
	// CanonicalURLはリンクカードのcanonical_urlをエコーバックし、送信失敗時に紐付けたリンクカードを保持する (リンク未紐付け時は空)。
	CanonicalURL string
	// AttachedLinkは送信失敗後に #link-form内へ再描画する解決済みリンクカード (リンク未紐付け時やURLが既知のリンクに解決できない場合はnil)。
	AttachedLink *viewmodel.Link
	// BackHrefは戻るリンクのフォールバック先 (referrerが同一オリジンのときback-linkスクリプトがhistory.back() に格上げする)。
	BackHref templates.Path
	// DraftStorageKeyは本文の下書き自動保存 (web/post_draft.ts) 用のユーザー別localStorageキー。空なら自動保存を無効化する (例: contextにプロフィールが無い場合)。
	DraftStorageKey string
}

// Newは新規投稿フォーム (本文textarea + 投稿ボタン + CSRF) を描画する。
// フォームはRailsのpost_list_pathに対応する /postsに送信する。送信失敗時は
// バリデーションエラーと送信済み本文を添えて再描画する。textareaはRailsの
// post_form_componentと同様に、#link-formのhtmxコンテナ・文字数カウンターと
// 同じ枠付きコンテナに収める。
templ New(data NewPageData) {
	{{ hasContentError := data.FormErrors != nil && data.FormErrors.HasFieldError("content") }}
	// navbarと水平方向の中央寄せはlayouts.Centeredが担う。このページは
	// コンテンツ幅 (max-w-2xl) と端の余白 (px-4) だけを持つ。戻る導線
	// (components.BackLink) はコンテンツカラム上部に控えめなリンクとして置く。これに
	// より操作行は投稿ボタン1つだけになり、マイクロブログのcompose慣習 (添付を左・
	// 投稿を右) に沿って右端へ寄せられる。
	<div class="w-full max-w-2xl px-4">
		<div class="flex flex-col gap-4">
			// ただ1つの <h1> でページの見出し階層を確立する。集中作成画面は可視の
			// ページタイトルを持たない (textareaのラベル「いま何してる？」が視覚的に
			// フォームを先導する) ため、h1は支援技術向けにsr-onlyとする。
			<h1 class="sr-only">{ templates.T(ctx, "post_new_heading") }</h1>

			@components.BackLink(data.BackHref)

			@components.FormErrors(data.FormErrors)

			<form
				action="/posts"
				class="grid gap-4"
				hx-on:submit="disableSubmitButtons(this)"
				method="POST"
			>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

				<div class="grid gap-2">
					// Railsの「いま何してる？」を本文textareaのラベルに使う (Railsの
					// 投稿フォームは独立見出しも汎用的な「本文」ラベルも持たない)。
					<label class="label font-bold" for="content">
						{ templates.T(ctx, "post_new_content_label") }
					</label>

					// textarea・リンクカード領域・文字数カウンターを収める枠付きコンテナ
					// (Rails投稿フォームの .textareaラッパーに対応)。枠線はbasecoatの
					// .textareaスタイルで内側のtextareaではなくこのコンテナに描き、
					// フォーカスリングはfocus-withinで再現する。内側のtextareaには
					// outline-noneを付け、ブラウザ既定のoutlineと二重にならず、このリングだけが
					// フォーカス表示になるようにする。
					//
					// basecoatの .textareaは [color,box-shadow] しか遷移しないため、フォーカス時に
					// 枠線色は即座に切り替わり、リング (box-shadow) だけ遅れてフェードインして両者の
					// タイミングがずれる。遷移対象にborder-colorを含めduration/easingを付けて
					// 上書きし、枠線とリングが同時にふわっとフェードインするようにする。
					<div
						class={ "textarea w-full flex-col p-0 transition-[color,box-shadow,border-color] duration-200 ease-out focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/50",
							templ.KV("border-destructive", hasContentError) }
					>
						// data-draft-keyは本文をlocalStorageの下書き自動保存
						// (web/post_draft.ts) の対象にする: 編集はデバウンスしてこのユーザー別キーへ保存し、
						// ページが隠れるときに保留中の書き込みを確定して、戻ってきたときに復元する。
						// タブ閉じ・リロード・端末の戻るでも最新値が残り、実際の送信ではクリアされる。
						// キーは投稿者のプロフィールIDにスコープするため、共有
						// 端末で前ユーザーの未送信下書きが次のユーザーに復元されない。contextに
						// プロフィールが無いとき (例: RequireAuth外の /newテスト) は属性を省き、共有
						// キーへの書き込みではなく自動保存の無効化とする。
						<textarea
							autofocus
							class="w-full resize-none px-4 py-2 text-base leading-loose outline-none md:text-sm"
							data-autosize
							if data.DraftStorageKey != "" {
								data-draft-key={ data.DraftStorageKey }
							}
							data-link-card-path="/links/new"
							id="content"
							if hasContentError {
								aria-invalid="true"
							} else {
								aria-invalid="false"
							}
							name="content"
							required
							rows="1"
						>{ data.Content }</textarea>

						// textareaの下のこの領域全体 (リンクカード + 文字数カウンター) は同じ
						// 枠付きボックスに属するため、textareaの一部のように振る舞わせる: クリックすると
						// #contentにフォーカスし (data-focus-textarea。配線はweb/main.js)、cursor-textで
						// textareaと同じテキストカーソルを表示する。これにより枠の下部領域が死んだ余白では
						// なく編集可能領域のように感じられる。#link-formは除外し (data-focus-proxy-ignore +
						// cursor-auto)、リンクカード自身のクリック・カーソルを維持する。
						<div class="cursor-text px-4 py-2" data-focus-textarea="content">
							// リンクカードのフラグメント (GET /links/newとPOST /links) を
							// スワップするhtmxターゲット。再描画するリンクカード (linkに解決
							// できない場合はエコーバックするcanonical_urlのみ) をこの中に置く
							// ことで、送信失敗後もURL検出がコンテナを使用中とみなし、2つ目の
							// リンクを紐付けない。
							<div id="link-form" class="cursor-auto" data-focus-proxy-ignore>
								if data.AttachedLink != nil {
									@components.AttachedLinkCard(*data.AttachedLink)
								} else if data.CanonicalURL != "" {
									<input type="hidden" name="canonical_url" value={ data.CanonicalURL }/>
								}
							</div>

							<div class="text-right">
								<span
									class="text-sm text-gray-500"
									data-character-counter-for="content"
									data-character-counter-max={ strconv.Itoa(viewmodel.MaximumPostContentLength) }
								></span>
							</div>
						</div>
					</div>

					if hasContentError {
						for _, errorMsg := range data.FormErrors.GetFieldErrors("content") {
							<p class="text-sm text-error">
								{ errorMsg }
							</p>
						}
					}
				</div>

				// マイクロブログのcompose慣習では添付を左、投稿操作を右に置くため、
				// この操作行は添付コントロールを追加できる構成にする。
				<div class="flex items-center justify-end">
					<button class="btn rounded-full w-fit" type="submit">
						// 先頭の送信アイコン。btnがsize指定無しのsvgをsize-4にし
						// gapも付ける。アイコンはfill="currentColor" でボタンの文字色を継承する。
						@templates.Icon("paper-plane-tilt-regular")
						{ templates.T(ctx, "post_new_submit") }
					</button>
				</div>
			</form>
		</div>
	</div>
}
