package password_reset

import (
	"github.com/mewstcom/mewst/go/internal/session"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
)

// NewPageData はパスワードリセットフォームページのデータ
type NewPageData struct {
	CSRFToken        string
	TurnstileSiteKey string
	FormErrors       *session.FormErrors
	Email            string
}

// New はパスワードリセットフォームを表示する
templ New(data NewPageData) {
	<div class="max-w-lg w-full flex flex-col gap-6 px-4">
		<div class="text-center">
			<a href="/" class="inline-block">
				<div class="bg-(--primary) rounded-xl">
					@templates.Icon("logo", "fill-black w-[60px] h-[60px]")
				</div>
			</a>
		</div>

		<div class="flex flex-col gap-2">
			<h1 class="text-center text-3xl font-bold antialiased">
				{ templates.T(ctx, "password_reset_title") }
			</h1>
			<p class="text-center text-muted-foreground">
				{ templates.T(ctx, "password_reset_description") }
			</p>
		</div>

		@components.FormErrors(data.FormErrors)

		<form
			action="/password_reset"
			class="form grid gap-6"
			data-on:submit__passive="$isSubmitting = true"
			method="POST"
		>
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

			<div class="grid gap-2">
				<label for="email">
					{ templates.T(ctx, "label_email") }
				</label>

				<input
					if data.FormErrors != nil && data.FormErrors.Fields["email"] != nil {
						aria-invalid="true"
					} else {
						aria-invalid="false"
					}
					autocomplete="email"
					autofocus
					id="email"
					name="email"
					required
					tabindex="1"
					type="email"
					value={ data.Email }
				/>

				if data.FormErrors != nil && data.FormErrors.Fields["email"] != nil {
					for _, errorMsg := range data.FormErrors.Fields["email"] {
						<p class="text-sm text-(--error)">
							{ errorMsg }
						</p>
					}
				}
			</div>

			@components.Turnstile(data.TurnstileSiteKey)

			<button
				class="btn rounded-full w-fit text-black"
				tabindex="2"
				type="submit"
				data-attr:disabled="$isSubmitting == true"
			>
				@templates.Icon("arrow-right")
				{ templates.T(ctx, "btn_send_reset_code") }
			</button>
		</form>

		<div class="text-center text-muted-foreground">
			<a class="link" href="/sign_in">
				{ templates.T(ctx, "back_to_sign_in") }
			</a>
		</div>
	</div>
}
