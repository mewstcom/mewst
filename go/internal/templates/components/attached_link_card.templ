package components

import (
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/viewmodel"
)

// AttachedLinkCardは紐付け済みリンクカードを描画する。カードのプレビュー・
// #link-formコンテナを空にする削除ボタン・外側の投稿フォームと一緒に送信されて
// 作成される投稿にカードを紐付けるhiddenのcanonical_urlから成る。POST /linksの
// フラグメントと投稿フォームの422再描画で共用する。
templ AttachedLinkCard(link viewmodel.Link) {
	<div class="mb-2">
		<div class="relative">
			@LinkCard(link)

			// #link-formを空にするとカードのプレビューとhiddenのcanonical_urlが
			// 両方消えるため、次の投稿はリンク無しで送信される。
			<button
				aria-label={ templates.T(ctx, "link_create_remove") }
				class="btn absolute right-0 top-0 m-2 rounded-full"
				data-size="icon"
				data-variant="outline"
				hx-on:click="document.getElementById('link-form').replaceChildren()"
				type="button"
			>
				@templates.Icon("close_fill", "h-4 w-4 [&_.content]:fill-foreground")
			</button>
		</div>

		<input type="hidden" name="canonical_url" value={ link.CanonicalURL }/>
	</div>
}
