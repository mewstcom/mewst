package layouts

import (
	"github.com/a-h/templ"
	"github.com/mewstcom/mewst/go/internal/session"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
	"github.com/mewstcom/mewst/go/internal/viewmodel"
)

// DefaultLayoutData holds the data passed to the authenticated shared layout.
// Navbar carries the current user's atname and the active menu item.
//
// [Ja] 認証後ページ共通レイアウトに渡すデータ構造体。Navbar は現在ユーザーの
// atname とアクティブなメニュー項目を保持する。
type DefaultLayoutData struct {
	Meta   viewmodel.PageMeta
	Navbar viewmodel.Navbar
}

// Default is the shared layout for authenticated pages: head, top navbar, main
// content, and the mobile bottom navbar. It mirrors the Rails BasicLayoutComponent.
//
// [Ja] 認証後ページの共通レイアウト。head・トップ navbar・main コンテンツ・
// モバイル用ボトム navbar で構成し、Rails の BasicLayoutComponent に対応する。
templ Default(data DefaultLayoutData, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(data.Meta)
		</head>

		<body>
			// Skip link as the first focusable element so keyboard / screen-reader users
			// can jump past the navbar straight to the main content (WCAG 2.4.1). It stays
			// visually hidden until focused, then surfaces at the top-left.
			//
			// [Ja] キーボード / スクリーンリーダー利用者が navbar を飛ばしてメインコンテンツへ
			// 直接移動できるよう、最初のフォーカス可能要素としてスキップリンクを置く
			// (WCAG 2.4.1)。フォーカス時のみ左上に可視化する。
			<a
				href="#main"
				class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-foreground focus:shadow focus:outline focus:outline-2 focus:outline-ring"
			>
				{ templates.T(ctx, "skip_to_main_content") }
			</a>
			@components.Flash(session.FlashFromContext(ctx))

			<div class="flex min-h-[100svh] flex-col">
				@components.TopNavbar(data.Navbar)

				<main id="main" tabindex="-1" class="flex-1">
					@content
				</main>

				// Pin the bottom navbar to the bottom-center on mobile (the component itself hides it on lg).
				// [Ja] モバイルではボトム navbar を画面下部中央に固定する (lg ではコンポーネント側で非表示)。
				<div class="fixed bottom-0 left-1/2 z-50 -translate-x-1/2 p-4">
					@components.BottomNavbar(data.Navbar)
				</div>
			</div>
		</body>
	</html>
}
