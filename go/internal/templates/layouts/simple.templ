package layouts

import (
	"github.com/a-h/templ"
	"github.com/mewstcom/mewst/internal/templates"
	"github.com/mewstcom/mewst/internal/templates/components"
)

// SimpleMeta はシンプルレイアウト用のメタデータ
type SimpleMeta struct {
	Title         string
	Description   string
	AssetVersion  string
}

// Simple はシンプルなレイアウトを提供する（ログインページ等で使用）
templ Simple(meta SimpleMeta, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(meta.Title, meta.Description, meta.AssetVersion)
		</head>

		<body class="min-h-screen flex items-center justify-center">
			@components.Flash()
			@content
		</body>
	</html>
}
