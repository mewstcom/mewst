package components

import "github.com/mewstcom/mewst/go/internal/viewmodel"

// HeadはHTMLヘッダーを生成する
templ Head(meta viewmodel.PageMeta) {
	<meta charset="utf-8"/>
	// 標準的なviewportを使う。`maximum-scale=1` や `user-scalable=no` は
	// 加えないこと。ピンチズームの無効化はWCAG 1.4.4 (Resize Text) に反する。
	// iOS Safariのフォーカス時自動ズームは、フォーム入力のフォントサイズを
	// 16px以上に保つことで回避している。
	//
	// viewport-fit=coverはページを端末のsafe areaまで広げ、env(safe-area-inset-*)
	// が非ゼロ値を返すようにする。これが無いとinsetは常に0になり、safe-area
	// ユーティリティ (例: mb-safe) が効かない。
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>

	<title>{ meta.Title }</title>

	<meta name="description" content={ meta.Description }/>

	<meta property="og:description" content={ meta.Description }/>
	<meta property="og:image" content={ meta.OGImage }/>
	<meta property="og:locale" content={ meta.OGLocale }/>
	<meta property="og:site_name" content="Mewst (ミュースト)"/>
	<meta property="og:title" content={ meta.Title }/>
	<meta property="og:type" content={ meta.OGType }/>
	<meta property="og:url" content={ meta.OGURL }/>

	// iOSのSafariで「ホームに追加」した時にフルスクリーン表示にする
	<meta name="apple-mobile-web-app-capable" content="yes"/>

	// canonicalリンク
	if meta.OGURL != "" {
		<link rel="canonical" href={ meta.OGURL }/>
	}

	// ファビコンとアイコン
	<link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png"/>
	<link rel="icon" href="/static/images/favicon.ico" sizes="any"/>
	<link rel="icon" href="/static/images/icon.svg" type="image/svg+xml"/>
	<link rel="manifest" href="/manifest.json"/>

	// Google Fonts (Itim)
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Itim&display=swap"/>

	// Cloudflare Turnstileプリコネクト
	<link rel="preconnect" href="https://challenges.cloudflare.com"/>

	<link rel="stylesheet" href={ "/static/css/style.css?v=" + meta.AssetVersion }/>

	// RailsからGoへの移行期は、ダークモード検出を意図的に無効化している。
	// Rails版にはダークモードが無いため、OSの設定に応じた `.dark` の付与をGo描画
	// ページだけで行うと、OSがダークを好むユーザーにはGoページがダーク・Railsページ
	// がライトで見え、体験が割れてしまう。`.dark {}` のCSSと `dark:` バリアントは
	// 残してあるため、全ページがGoで配信されるようになったら、下の検出スクリプトの
	// コメントを外すだけでダークモードを再有効化できる。
	//
	// <script>
	// 	(() => {
	// 		try {
	// 			if (matchMedia("(prefers-color-scheme: dark)").matches) {
	// 				document.documentElement.classList.add("dark");
	// 			}
	// 		} catch (_) {}
	// 	})();
	// </script>

	<script src={ "/static/js/vendor/htmx-4.0.0-alpha8.min.js?v=" + meta.AssetVersion }></script>
	<script type="module" src={ "/static/js/main.js?v=" + meta.AssetVersion }></script>
}
