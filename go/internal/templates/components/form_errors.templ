package components

import "github.com/mewstcom/mewst/go/internal/model"

// FormErrorsはフォームのグローバルエラーを、1メッセージにつき1つの
// アラートとして表示する。
templ FormErrors(formErrors *model.ValidationError) {
	if formErrors != nil && len(formErrors.Global) > 0 {
		for _, errorMsg := range formErrors.Global {
			<div class="alert" data-variant="destructive">
				<h2>{ errorMsg }</h2>
			</div>
		}
	}
}
