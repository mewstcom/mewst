package exports

// documentHeadはアーカイブの各HTMLファイルで共通のheadを描画する。
//
// 文字コード宣言はheadの最初の子に置き、ブラウザが文字コードを判定するために
// 読む先頭1024バイトに余裕をもって収まるようにする。これらのファイルはローカル
// ファイルシステムから開かれ、頼れるContent-Typeヘッダーが無いため。
templ documentHead(data DocumentData) {
	<head>
		<meta charset="utf-8"/>
		// maximum-scaleやuser-scalableは加えない。スマートフォンで自分の
		// アーカイブを読む人からピンチズームを奪うことはWCAG 1.4.4に反する。
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		// 読み手のダーク設定がスタイルシートの解析より前にブラウザへ届く
		// ため、ページは白く光ってからではなく最初からダークで開く。
		<meta name="color-scheme" content="light dark"/>
		<meta name="mewst-export-format" content={ FormatVersion }/>
		<title>{ data.Title }</title>
		// アーカイブはファイルアプリからオフラインで読まれ、リンクした
		// スタイルシートは解決できないため、スタイルシートはインラインにする。
		// レイアウトは固定幅を持たない。rem指定のmax-widthで中央寄せすることで、
		// スマートフォンでは横スクロールを生じさせずに画面幅を使い、デスクトップ
		// でも読みやすい幅に収まる。配色は読み手のライト / ダークの設定に従う。
		// ポストの本文はwhite-space: pre-wrapで表示し、書かれたときの改行を
		// 折り畳まずそのまま見せる。ブランドマークの寸法はrem指定にして読み手の
		// 文字サイズに合わせて拡大させる。色は周囲のテキストから受け取るため、
		// スタイルシートでは色を指定しない。
		<style>
			:root { color-scheme: light dark; }
			body {
				margin: 0;
				padding: 1.5rem 1rem 3rem;
				font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif;
				line-height: 1.8;
				color: #1c1c1e;
				background-color: #ffffff;
				overflow-wrap: anywhere;
			}
			main { margin: 0 auto; max-width: 40rem; }
			.brand {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				margin: 0 0 1.5rem;
				font-weight: 700;
			}
			.brand svg { width: 1.5rem; height: 1.5rem; }
			h1 { margin: 0 0 1rem; font-size: 1.5rem; line-height: 1.4; }
			ul { margin: 1.5rem 0 0; padding: 0; list-style: none; }
			li {
				display: flex;
				flex-wrap: wrap;
				gap: 0 1rem;
				align-items: baseline;
				justify-content: space-between;
				border-top: 1px solid #d9d9de;
			}
			li a { display: inline-block; padding: 0.75rem 0; }
			a { color: #0b57d0; }
			article { padding: 1rem 0; border-top: 1px solid #d9d9de; }
			.dt-published { display: block; }
			.e-content { margin: 0.25rem 0 0; white-space: pre-wrap; }
			.post-count, .dt-published { color: #4c4c51; font-size: 0.875rem; }
			@media (prefers-color-scheme: dark) {
				body { color: #f2f2f7; background-color: #1c1c1e; }
				li, article { border-top-color: #48484a; }
				a { color: #8ab4f8; }
				.post-count, .dt-published { color: #b0b0b8; }
			}
		</style>
	</head>
}
