package link

import (
	"github.com/mewstcom/mewst/go/internal/model"
	"github.com/mewstcom/mewst/go/internal/templates"
)

// NewPageDataはリンクカード追加プロンプトのフラグメントのデータを保持する。
type NewPageData struct {
	CSRFToken string
	// TargetURLは投稿本文から検出したURL。hiddenフィールドとしてPOST /linksに渡す。
	TargetURL string
	// HostAndPathはボタンラベルに表示するTargetURLの短縮したhost + path。
	HostAndPath string
	// FormErrorsはPOST /links失敗後に再表示するバリデーションエラー (初回表示時はnil)。
	FormErrors *model.ValidationError
}

// Newはリンクカード追加プロンプトのフラグメント (Railsのlinks/new/call
// ビュー) を描画する。検出したURLをhtmxでPOST /linksに送信し、得られた
// リンクカードを投稿フォーム内の #link-formコンテナにスワップするボタン。
templ New(data NewPageData) {
	<form hx-disable="find button[type='submit']" hx-post="/links" hx-target="#link-form">
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		<input type="hidden" name="target_url" value={ data.TargetURL }/>

		if data.FormErrors != nil && data.FormErrors.HasFieldError("target_url") {
			for _, errorMsg := range data.FormErrors.GetFieldErrors("target_url") {
				<p class="text-sm text-error">
					{ errorMsg }
				</p>
			}
		}

		<button class="btn rounded-full" data-variant="outline" type="submit">
			{ templates.T(ctx, "link_new_submit", map[string]any{"HostAndPath": data.HostAndPath}) }
		</button>
	</form>
}
