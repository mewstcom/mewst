  # @!macro notification_responder
  #
  # pkg:gem/good_job#lib/good_job/log_subscriber.rb:51
  def scheduler_create_pool(event); end

  # @!macro notification_responder
  #
  # pkg:gem/good_job#lib/good_job/log_subscriber.rb:103
  def scheduler_restart_pools(event); end

  # @!macro notification_responder
  #
  # pkg:gem/good_job#lib/good_job/log_subscriber.rb:81
