package sign_in

import (
	"github.com/mewstcom/mewst/internal/session"
	"github.com/mewstcom/mewst/internal/templates"
	"github.com/mewstcom/mewst/internal/templates/components"
)

// NewPageData はログインフォームページのデータ
type NewPageData struct {
	CSRFToken       string
	TurnstileSiteKey string
	FormErrors      *session.FormErrors
	Email           string
}

// New はログインフォームを表示する
templ New(data NewPageData) {
	<div class="flex flex-col gap-6 min-w-full md:min-w-md px-4">
		<div class="text-center">
			<a href="/" class="inline-block">
				<img
					alt="Annict"
					src="/static/images/logo-mizuho.png"
					width="50"
				/>
			</a>
		</div>
	</div>

	<div class="text-center">
		<div class="mt-12">
			<a href="/" class="inline-block">
				@Logo()
			</a>
		</div>

		<h1 class="mt-8 text-3xl font-bold">
			{ templates.T(ctx, "meta.title.sign_in.new") }
		</h1>

		<p class="mt-4">
			{ templates.T(ctx, "messages.sign_in.dont_have_an_account") }
			<a class="link link-info" href="/sign_up">{ templates.T(ctx, "meta.title.sign_up.new") }</a>
		</p>
	</div>

	<div class="card bg-base-100 shadow-xl mt-8">
		<div class="card-body">
			<form method="POST" action="/sign_in">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

				@components.FormErrors(data.FormErrors)

				<label class="form-control" for="email">
					<div class="label">
						<span class="label-text">
							{ templates.T(ctx, "forms.attributes.session_form.email") }
						</span>
					</div>
					<input
						type="email"
						id="email"
						name="email"
						autocomplete="username"
						autofocus
						class="input input-bordered w-full"
						required
						tabindex="1"
						value={ data.Email }
					/>
				</label>

				<label class="form-control mt-8" for="password">
					<div class="label">
						<span class="label-text">
							{ templates.T(ctx, "forms.attributes.session_form.password") }
						</span>
						<span class="label-text-alt">
							<a class="link" href="/password_reset" tabindex="4">
								{ templates.T(ctx, "meta.title.password_resets.new") }
							</a>
						</span>
					</div>
					<input
						type="password"
						id="password"
						name="password"
						autocomplete="current-password"
						class="input input-bordered w-full"
						required
						tabindex="2"
					/>
				</label>

				@components.Turnstile(data.TurnstileSiteKey)

				<div class="mt-8 text-center">
					<button class="btn btn-primary no-animation rounded-full" tabindex="3" type="submit">
						{ templates.T(ctx, "verbs.sign_in") }
					</button>
				</div>
			</form>
		</div>
	</div>
}

// Logo はロゴアイコンを表示する
templ Logo() {
	<svg width="50" height="50" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Mewst">
		<circle cx="50" cy="50" r="45" fill="currentColor" class="text-primary"/>
		<text x="50" y="65" text-anchor="middle" fill="white" font-size="40" font-weight="bold">M</text>
	</svg>
}
