package emails

import "github.com/mewstcom/mewst/internal/templates"

// EmailConfirmationData はメール確認テンプレートのデータ
type EmailConfirmationData struct {
	Email string // 送信先メールアドレス
	Code  string // 確認コード
}

// EmailConfirmation はメール確認用のメールテンプレート
templ EmailConfirmation(data EmailConfirmationData) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		</head>
		<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
			<div style="background-color: #f9fafb; border-radius: 8px; padding: 32px;">
				<p style="margin: 0 0 16px 0;">
					{ templates.T(ctx, "email_confirmation_greeting", map[string]any{"Email": data.Email}) }
				</p>
				<p style="margin: 0 0 16px 0;">
					{ templates.T(ctx, "email_confirmation_code_intro") }
				</p>
				<div style="background-color: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px; text-align: center; margin: 24px 0;">
					<span style="font-size: 32px; font-weight: bold; letter-spacing: 8px; color: #111;">
						{ data.Code }
					</span>
				</div>
				<p style="margin: 0 0 16px 0; color: #6b7280; font-size: 14px;">
					{ templates.T(ctx, "email_confirmation_expiration") }
				</p>
				<p style="margin: 0 0 16px 0; color: #6b7280; font-size: 14px;">
					{ templates.T(ctx, "email_confirmation_ignore") }
				</p>
				<hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;"/>
				<p style="margin: 0; color: #9ca3af; font-size: 12px;">
					Mewst<br/>
					<a href="https://mewst.com" style="color: #6b7280;">https://mewst.com</a>
				</p>
			</div>
		</body>
	</html>
}
