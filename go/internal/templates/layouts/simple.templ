package layouts

import (
	"github.com/a-h/templ"
	"github.com/mewstcom/mewst/go/internal/session"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
	"github.com/mewstcom/mewst/go/internal/viewmodel"
)

// SimpleLayoutData holds the data passed to the simple layout.
//
// [Ja] SimpleLayoutData はシンプルレイアウトに渡すデータ構造体。
type SimpleLayoutData struct {
	Meta viewmodel.PageMeta
}

// Simple is a navbar-less, centered single-column layout used by unauthenticated
// authentication forms. It provides the skip link and the single <main>
// landmark so every page built on it satisfies WCAG 2.4.1 / semantic-html
// without repeating the markup per page.
//
// [Ja] Simple は未認証の認証フォームで使う、navbar 無しの中央寄せ単一カラム
// レイアウト。スキップリンクとただ 1 つの <main> ランドマークを備え、これを土台にする
// 全ページがページごとにマークアップを繰り返さずに WCAG 2.4.1 / semantic-html を満たす。
templ Simple(data SimpleLayoutData, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(data.Meta)
		</head>

		// Keep the centered authentication content inside every constrained edge.
		// Safe-area values resolve to zero on displays without constrained edges.
		//
		// [Ja] 中央寄せの認証コンテンツを全辺の safe area 内に収める。
		// 制約のない画面では safe-area の値が 0 になり、従来の配置を維持する。
		<body class="min-h-screen flex items-center justify-center p-safe">
			@components.SkipLink()
			@components.Flash(session.FlashFromContext(ctx))
			// Wrap the page content in the single <main> landmark. w-full gives the
			// page's inner column a definite full-width parent so its max-width resolves,
			// and justify-center keeps the column centered (the vertical centering comes
			// from the body's items-center). tabindex="-1" lets the skip link move focus
			// here without making <main> a tab stop.
			//
			// [Ja] ページコンテンツをただ 1 つの <main> ランドマークで包む。w-full でページ
			// 内側カラムに幅の定まった親を与え max-width を解決させ、justify-center でカラムを
			// 中央寄せする (上下中央寄せは body の items-center が担う)。tabindex="-1" により
			// <main> をタブ停止点にせずにスキップリンクからフォーカスを移動できる。
			<main id="main" tabindex="-1" class="flex w-full justify-center">
				@content
			</main>
		</body>
	</html>
}
