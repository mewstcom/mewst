  # Get the logger associated with this {LogSubscriber} instance.
  # @return [Logger]
  #
  # pkg:gem/good_job#lib/good_job/log_subscriber.rb:186
  def logger; end

  # @!macro notification_responder
  #
  # pkg:gem/good_job#lib/good_job/log_subscriber.rb:123
