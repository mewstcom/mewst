# Mewst Go版 環境変数サンプル
# このファイルをコピーして .env を作成し、実際の値を設定してください
# cp .env.example .env

DATABASE_URL=
MEWST_ADMIN_IP=
MEWST_COOKIE_DOMAIN=
MEWST_DISABLE_RATE_LIMIT=
MEWST_DOMAIN=
MEWST_EMAIL_FROM=
MEWST_EMAIL_FROM_NAME=
MEWST_MAINTENANCE_MODE=
MEWST_PORT=
MEWST_RAILS_APP_URL=
MEWST_RESEND_API_KEY=
# Object storage for exports (S3-compatible - Cloudflare R2). Set all four
# required values to enable the export storage, or leave every value unset to
# keep it disabled. A partial set fails startup. MEWST_S3_REGION is optional
# (default: "auto").
#
# [Ja] エクスポート用オブジェクトストレージ (S3 互換 - Cloudflare R2)。
# 必須 4 項目をすべて設定するとエクスポート用ストレージが有効になり、全項目未設定なら
# 無効のまま起動する。一部だけの設定は起動時エラーになる。MEWST_S3_REGION は任意
# (既定: "auto")。
MEWST_S3_ACCESS_KEY_ID=
MEWST_S3_BUCKET_NAME=
MEWST_S3_ENDPOINT=
MEWST_S3_REGION=
MEWST_S3_SECRET_ACCESS_KEY=
MEWST_SENTRY_DEBUG=                    # Sentry SDK のデバッグログ出力。"true" で有効 (既定: false)
MEWST_SENTRY_DSN=                      # Sentry のプロジェクト DSN。空のときは Sentry を無効化する (既定: 空)
MEWST_SENTRY_ENVIRONMENT=              # Sentry の environment タグ。空の場合は APP_ENV を使用 (既定: APP_ENV)
MEWST_SENTRY_TRACES_SAMPLE_RATE=       # パフォーマンストレースのサンプリングレート (0.0〜1.0、既定: 0.5)
MEWST_SESSION_HTTPONLY=
MEWST_SESSION_SECURE=
# MEWST_TURNSTILE_DISABLE=true disables Turnstile in non-production with one flag,
# so the MEWST_TURNSTILE_SITE_KEY / MEWST_TURNSTILE_SECRET_KEY pair no longer needs
# to be unset for local browsing. This flag is ignored in production (fail-closed),
# so it cannot disable bot protection there.
#
# [Ja] MEWST_TURNSTILE_DISABLE=true は非本番で Turnstile を 1 フラグで無効化する。
# ローカルでのブラウザ確認のために MEWST_TURNSTILE_SITE_KEY / MEWST_TURNSTILE_SECRET_KEY
# の 2 キーを未設定にする必要が無くなる。このフラグは本番では無視される (fail-closed) ため、
# このフラグによって Bot 対策が無効化されることはない。
MEWST_TURNSTILE_DISABLE=
MEWST_TURNSTILE_SECRET_KEY=
MEWST_TURNSTILE_SITE_KEY=
