package components

// AuthFormCardは認証フォームを、認証系の各画面 (ログイン / サインアップ /
// アカウント作成 / メール確認 / パスワード更新 / パスワードリセット) で共有する
// カードに収める。カードの面とそのレスポンシブな見た目 (狭い画面では全幅・角なし、
// md以上では余白を持つ角丸カード) を担い、各画面は内側のフォームだけを渡す。
templ AuthFormCard() {
	<div class="card py-4 rounded-none md:rounded-xl mx-0 md:mx-4">
		<section class="px-4">
			{ children... }
		</section>
	</div>
}
