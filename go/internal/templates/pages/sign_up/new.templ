package sign_up

import (
	"github.com/mewstcom/mewst/go/internal/model"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
)

// NewPageData はサインアップフォームページのデータ
type NewPageData struct {
	CSRFToken        string
	TurnstileSiteKey string
	FormErrors       *model.ValidationError
	Email            string
	BackURL          string
}

// New はサインアップフォームを表示する
templ New(data NewPageData) {
	<div class="max-w-lg w-full flex flex-col gap-6 px-4">
		<div class="text-center">
			<a href="/" class="inline-block">
				<div class="bg-primary rounded-xl">
					@templates.Icon("logo", "fill-black w-[60px] h-[60px]")
				</div>
			</a>
		</div>

		<div class="flex flex-col gap-2">
			<h1 class="text-center text-3xl font-bold antialiased">
				{ templates.T(ctx, "sign_up_title") }
			</h1>

			<p class="text-center text-sm text-muted-foreground whitespace-pre-line">
				{ templates.T(ctx, "sign_up_description") }
			</p>
		</div>

		@components.FormErrors(data.FormErrors)

		<div class="card py-4 rounded-none md:rounded-xl mx-0 md:mx-4">
			<section class="px-4">
				<form
					action="/sign_up"
					class="form grid gap-6"
					hx-on:submit="disableSubmitButtons(this)"
					method="POST"
				>
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					if data.BackURL != "" {
						<input type="hidden" name="back" value={ data.BackURL }/>
					}

					<div class="grid gap-2">
						<label for="email">
							{ templates.T(ctx, "label_email") }
						</label>

						<input
							if data.FormErrors != nil && data.FormErrors.HasFieldError("email") {
								aria-invalid="true"
							} else {
								aria-invalid="false"
							}
							autocomplete="email"
							autofocus
							id="email"
							name="email"
							required
							tabindex="1"
							type="email"
							value={ data.Email }
						/>

						if data.FormErrors != nil && data.FormErrors.HasFieldError("email") {
							for _, errorMsg := range data.FormErrors.GetFieldErrors("email") {
								<p class="text-sm text-error">
									{ errorMsg }
								</p>
							}
						}
					</div>

					@components.Turnstile(data.TurnstileSiteKey)

					<button
						class="btn-primary rounded-full w-fit"
						tabindex="2"
						type="submit"
					>
						@templates.Icon("arrow-right-regular")
						{ templates.T(ctx, "btn_send_confirmation_code") }
					</button>
				</form>
			</section>
		</div>

		<div class="text-center text-muted-foreground">
			{ templates.T(ctx, "sign_up_have_account") }
			{ " " }
			<a class="link" href="/sign_in">
				{ templates.T(ctx, "sign_up_sign_in") }
			</a>
		</div>
	</div>
}
