    "basecoat-css": "^0.3.2",
    "esbuild": "^0.25.8",
    "graphemesplit": "^2.6.0",
    "stimulus-use": "^0.52.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@ttskch/prettier-plugin-tailwindcss-anywhere": "^0.1.1",
    "@types/autosize": "^4.0.3",
    "@types/hotwired__turbo": "^8.0.4",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0"
