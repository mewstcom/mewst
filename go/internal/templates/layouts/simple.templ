package layouts

import (
	"github.com/a-h/templ"
	"github.com/mewstcom/mewst/go/internal/session"
	"github.com/mewstcom/mewst/go/internal/templates"
	"github.com/mewstcom/mewst/go/internal/templates/components"
	"github.com/mewstcom/mewst/go/internal/viewmodel"
)

// SimpleLayoutDataはシンプルレイアウトに渡すデータ構造体。
type SimpleLayoutData struct {
	Meta viewmodel.PageMeta
}

// Simpleは未認証の認証フォームで使う、navbar無しの中央寄せ単一カラム
// レイアウト。スキップリンクとただ1つの <main> ランドマークを備え、これを土台にする
// 全ページがページごとにマークアップを繰り返さずにWCAG 2.4.1 / semantic-htmlを満たす。
templ Simple(data SimpleLayoutData, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(data.Meta)
		</head>

		// 中央寄せの認証コンテンツを全辺のsafe area内に収める。
		// 制約のない画面ではsafe-areaの値が0になり、従来の配置を維持する。
		<body class="min-h-screen flex items-center justify-center p-safe">
			@components.SkipLink()
			@components.Flash(session.FlashFromContext(ctx))
			// ページコンテンツをただ1つの <main> ランドマークで包む。w-fullでページ
			// 内側カラムに幅の定まった親を与えmax-widthを解決させ、justify-centerでカラムを
			// 中央寄せする (上下中央寄せはbodyのitems-centerが担う)。tabindex="-1" により
			// <main> をタブ停止点にせずにスキップリンクからフォーカスを移動できる。
			<main id="main" tabindex="-1" class="flex w-full justify-center">
				@content
			</main>
		</body>
	</html>
}
