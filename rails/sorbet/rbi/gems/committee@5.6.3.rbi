# Handles temporary parameter exclusion during schema validation.
# Allows testing error responses without validation failures for intentionally missing parameters.
#
# pkg:gem/committee#lib/committee/test/except_parameter.rb:7
class Committee::Test::ExceptParameter
  # @param [Rack::Request] request The request object
  # @param [Hash] committee_options Committee options hash
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:12
  def initialize(request, committee_options); end

  # Apply dummy values to excepted parameters
  # @param [Hash] except Hash of parameter types to parameter names
  #   (e.g., { headers: ['authorization'], query: ['page'] })
  # @return [void]
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:22
  def apply(except); end

  # Restore original parameter values
  # @return [void]
  #
  # pkg:gem/committee#lib/committee/test/except_parameter.rb:31
  def restore; end

  private

  # pkg:gem/committee#lib/committee/test/except_parameter.rb:37
  def handler_for(param_type); end
end

# Base handler for parameters stored in hash-like structures.
# Subclasses implement #get_storage and optionally #dummy_value_for.
#
# pkg:gem/committee#lib/committee/test/except_parameter.rb:109
class Committee::Test::ExceptParameter::BaseHashParameterHandler
  include ::Committee::Test::ExceptParameter::StringDummyLookup

