# SdNotify is a pure-Ruby implementation of sd_notify(3). It can be used to
# notify systemd about state changes. Methods of this package are no-op on
# non-systemd systems (eg. Darwin).
#
# The API maps closely to the original implementation of sd_notify(3),
# therefore be sure to check the official man pages prior to using SdNotify.
#
# @see https://www.freedesktop.org/software/systemd/man/sd_notify.html
#
# pkg:gem/good_job#lib/good_job/sd_notify.rb:45
module GoodJob::SdNotify
  class << self
    # @param errno [Integer]
    #
    # pkg:gem/good_job#lib/good_job/sd_notify.rb:77
    def errno(errno, unset_env = T.unsafe(nil)); end

    # pkg:gem/good_job#lib/good_job/sd_notify.rb:90
    def fdstore(unset_env = T.unsafe(nil)); end

    # @param pid [Integer]
    #
    # pkg:gem/good_job#lib/good_job/sd_notify.rb:82
    def mainpid(pid, unset_env = T.unsafe(nil)); end

    # Notify systemd with the provided state, via the notification socket, if
    # any.
    #
    # Generally this method will be used indirectly through the other methods
    # of the library.
    #
    # @param state [String]
    # @param unset_env [Boolean]
    #
    # @return [Fixnum, nil] the number of bytes written to the notification
    #   socket or nil if there was no socket to report to (eg. the program wasn't
    #   started by systemd)
    #
    # @raise [NotifyError] if there was an error communicating with the systemd
    #   socket
    #
    # @see https://www.freedesktop.org/software/systemd/man/sd_notify.html
    #
    # pkg:gem/good_job#lib/good_job/sd_notify.rb:138
    def notify(state, unset_env = T.unsafe(nil)); end

    # pkg:gem/good_job#lib/good_job/sd_notify.rb:58
    def ready(unset_env = T.unsafe(nil)); end

    # pkg:gem/good_job#lib/good_job/sd_notify.rb:62
    def reloading(unset_env = T.unsafe(nil)); end

    # @param status [String] a custom status string that describes the current
    #   state of the service
    #
    # pkg:gem/good_job#lib/good_job/sd_notify.rb:72
    def status(status, unset_env = T.unsafe(nil)); end

    # pkg:gem/good_job#lib/good_job/sd_notify.rb:66
    def stopping(unset_env = T.unsafe(nil)); end

    # pkg:gem/good_job#lib/good_job/sd_notify.rb:86
    def watchdog(unset_env = T.unsafe(nil)); end

    # @return [Boolean] true if the service manager expects watchdog keep-alive
    #   notification messages to be sent from this process.
    #
    # If the $WATCHDOG_USEC environment variable is set,
    # and the $WATCHDOG_PID variable is unset or set to the PID of the current
    # process
    #
    # @note Unlike sd_watchdog_enabled(3), this method does not mutate the
    #   environment.
    #
    # pkg:gem/good_job#lib/good_job/sd_notify.rb:103
    def watchdog?; end
  end
end

