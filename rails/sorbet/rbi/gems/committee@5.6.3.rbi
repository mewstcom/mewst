  # @param [Array<OpenAPIParser::Schemas::Parameter>] params_for_location
  # @return [Boolean]
  #
  # pkg:gem/committee#lib/committee/schema_validator/open_api_3/parameter_deserializer.rb:145
  def should_flatten_query_param?(key, value, params_for_location); end
end

