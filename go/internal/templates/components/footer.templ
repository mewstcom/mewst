package components

import "github.com/mewstcom/mewst/go/internal/templates"

// BasicFooter renders the shared footer for authenticated pages. It contains a
// wordmark link to the site root and four navigation links.
//
// [Ja] BasicFooter は認証後ページ共通のフッターを描画する。サイトルートへの
// ワードマークリンクと 4 つのナビゲーションリンクで構成する。
templ BasicFooter() {
	<footer class="mx-auto w-full max-w-2xl px-4 py-4">
		<div class="flex flex-col gap-2">
			<div class="text-center">
				@LogoLink() {
					<span class="font-['Itim'] text-3xl text-foreground">Mewst</span>
				}
			</div>

			<div class="flex justify-center gap-4">
				@footerLink(string(templates.CommunityPath()), "Community")
				@footerLink("https://wikino.app/s/mewst/topics/1", "Help")
				@footerLink(string(templates.TermsPath()), "Terms")
				@footerLink(string(templates.PrivacyPath()), "Privacy")
			</div>
		</div>
	</footer>
}

// footerLink renders a footer link that opens in a new tab. A localized,
// visually hidden hint announces this behavior to assistive technology.
//
// [Ja] footerLink は新規タブで開くフッターリンクを描画する。この動作を
// 支援技術へ伝える、ローカライズ済みで視覚的に隠したヒントを付ける。
templ footerLink(href string, label string) {
	<a
		href={ href }
		target="_blank"
		rel="nofollow noopener"
		class="link-bare-muted-foreground inline-flex min-h-6 items-center rounded-sm text-sm font-bold uppercase focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>
		<span lang="en">{ label }</span>
		<span class="sr-only">{ templates.T(ctx, "footer_opens_in_new_tab") }</span>
	</a>
}
