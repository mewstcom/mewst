package components

import (
	"github.com/mewstcom/mewst/go/internal/session"
	"github.com/mewstcom/mewst/go/internal/templates"
)

// Flash はフラッシュメッセージ用のtoasterコンテナを表示する
templ Flash() {
	<div id="toaster" class="toaster"></div>
}

// FlashMessage はフラッシュメッセージをtoastとして表示する
templ FlashMessage(flash *session.Flash) {
	if flash != nil {
		<div id="toaster" class="toaster">
			<div
				class="toast"
				role="status"
				aria-atomic="true"
				aria-hidden="false"
				data-category={ flashCategory(flash.Type) }
			>
				<div class="toast-content">
					@flashIcon(flash.Type)
					<section>
						<p class="whitespace-pre-line">{ flash.Message }</p>
					</section>
					<footer>
						<button type="button" class="btn" data-toast-action>{ templates.T(ctx, "flash_dismiss") }</button>
					</footer>
				</div>
			</div>
		</div>
	}
}

// flashCategory はフラッシュタイプに応じたdata-category属性値を返す
func flashCategory(flashType session.FlashType) string {
	switch flashType {
	case session.FlashSuccess:
		return "success"
	case session.FlashError:
		return "error"
	case session.FlashWarning:
		return "warning"
	default:
		return "info"
	}
}

// flashIcon はフラッシュタイプに応じたアイコンを返す
templ flashIcon(flashType session.FlashType) {
	switch flashType {
		case session.FlashSuccess:
			@templates.Icon("success", "fill-success")
		case session.FlashError:
			@templates.Icon("error", "fill-error")
		case session.FlashWarning:
			@templates.Icon("warning", "fill-warning")
		default:
			@templates.Icon("info", "fill-info")
	}
}
