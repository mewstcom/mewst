package sign_in

import (
	"github.com/mewstcom/mewst/internal/session"
	"github.com/mewstcom/mewst/internal/templates"
	"github.com/mewstcom/mewst/internal/templates/components"
)

// NewPageData はログインフォームページのデータ
type NewPageData struct {
	CSRFToken        string
	TurnstileSiteKey string
	FormErrors       *session.FormErrors
	Email            string
	BackURL          string
}

// New はログインフォームを表示する
templ New(data NewPageData) {
	<div class="flex flex-col gap-6 w-full sm:w-xl px-4">
		<div class="text-center">
			<a href="/" class="inline-block">
				<div class="bg-(--primary) rounded-xl">
					@templates.Icon("logo", "fill-black w-[60px] h-[60px]")
				</div>
			</a>
		</div>

		<div class="flex flex-col gap-2">
			<h1 class="text-center text-3xl font-bold antialiased">
				{ templates.T(ctx, "sign_in_title") }
			</h1>
		</div>

		@components.FormErrors(data.FormErrors)

		<form
			action="/sign_in"
			class="form grid gap-6"
			data-on:submit__passive="$isSubmitting = true"
			method="POST"
		>
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			if data.BackURL != "" {
				<input type="hidden" name="back" value={ data.BackURL }/>
			}

			<div class="grid gap-2">
				<label for="email">
					{ templates.T(ctx, "label_email") }
				</label>

				<input
					if data.FormErrors != nil && data.FormErrors.Fields["email"] != nil {
						aria-invalid="true"
					} else {
						aria-invalid="false"
					}
					autocomplete="email"
					autofocus
					id="email"
					name="email"
					required
					tabindex="1"
					type="email"
					value={ data.Email }
				/>

				if data.FormErrors != nil && data.FormErrors.Fields["email"] != nil {
					for _, errorMsg := range data.FormErrors.Fields["email"] {
						<p class="text-sm text-(--error)">
							{ errorMsg }
						</p>
					}
				}
			</div>

			<div class="grid gap-2">
				<div class="flex items-center gap-2">
					<label for="password">
						{ templates.T(ctx, "label_password") }
					</label>

					<a class="link text-sm ml-auto" href="/password_reset" tabindex="4">
						{ templates.T(ctx, "password_reset_title") }
					</a>
				</div>

				<input
					if data.FormErrors != nil && data.FormErrors.Fields["password"] != nil {
						aria-invalid="true"
					} else {
						aria-invalid="false"
					}
					autocomplete="current-password"
					id="password"
					name="password"
					required
					tabindex="2"
					type="password"
				/>

				if data.FormErrors != nil && data.FormErrors.Fields["password"] != nil {
					for _, errorMsg := range data.FormErrors.Fields["password"] {
						<p class="text-sm text-(--error)">
							{ errorMsg }
						</p>
					}
				}
			</div>

			@components.Turnstile(data.TurnstileSiteKey)

			<button
				class="btn rounded-full w-fit text-black"
				tabindex="3"
				type="submit"
				data-attr:disabled="$isSubmitting == true"
			>
				@templates.Icon("arrow-right")
				{ templates.T(ctx, "btn_sign_in") }
			</button>
		</form>

		<div class="text-center text-muted-foreground">
			{ templates.T(ctx, "sign_in_no_account") }
			{ " " }
			if data.BackURL != "" {
				<a class="link" href={ templ.SafeURL("/sign_up?back=" + data.BackURL) }>
					{ templates.T(ctx, "sign_up_title") }
				</a>
			} else {
				<a class="link" href="/sign_up">
					{ templates.T(ctx, "sign_up_title") }
				</a>
			}
		</div>
	</div>
}
