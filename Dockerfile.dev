# syntax=docker/dockerfile:1.7
FROM debian:trixie

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=developer

# BuildKitのキャッシュマウントでaptのダウンロード結果を保持する
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# --- システムパッケージ ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    <<EOF
set -eu

apt update
apt dist-upgrade -yq

PACKAGES=$(cat <<'PKGLIST' | sed 's/#.*//'
  bubblewrap                # CodexのLinux sandboxに必要
  build-essential
  ca-certificates           # HTTPS接続に必要
  curl
  file                      # Shrineによる画像アップロードに必要 (Rails)
  fonts-noto-cjk            # playwright-cliのスクショでCJKを描画 (豆腐回避)
  fzf                       # Claude Codeで使用
  git
  gnupg                     # PostgreSQLのGPGキーとaptリポジトリに必要
  jq                        # Claude Codeで使用
  libffi-dev                # Ruby拡張のビルドに必要
  libglib2.0-0              # libvipsの依存パッケージ (Rails)
  libreadline-dev           # Rubyのreadline拡張に必要
  libssl-dev                # SSL関連のビルドに必要
  libvips42                 # 画像処理ライブラリ (Rails)
  libyaml-dev               # psych gemのインストールに必要 (Rails)
  lsb-release               # PostgreSQLのaptリポジトリ設定に必要
  nano                      # Claude Codeで使用
  net-tools                 # Claude Codeで使用: netstat (ネットワークデバッグ用)
  procps                    # playwright-cliのkill-all用 (psを提供)
  psmisc                    # Claude Codeで使用: fuser (プロセス特定用)
  ripgrep                   # Claude Codeで使用
  sudo
  tree                      # Claude Codeで使用
  unzip
  vim                       # Claude Codeで使用
  zlib1g-dev                # Rubyのzlib拡張に必要 (gem installに必須)
  zsh
PKGLIST
)

apt install -y --no-install-recommends $PACKAGES
EOF

# --- PostgreSQLクライアント ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list && \
    apt update && apt install -y libpq-dev postgresql-client-18

# --- mise (開発ツールバージョンマネージャー) ---
# Docker環境向けの推奨設定: shims方式を使用する。
ENV MISE_DATA_DIR="/mise"
ENV MISE_CONFIG_DIR="/mise"
ENV MISE_CACHE_DIR="/mise/cache"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
ENV PATH="/mise/shims:${PATH}"
RUN curl -fsSL https://mise.run | sh

# Go、Ruby、Node.js、pnpm、Yarnをmise経由でインストール
RUN mise install go@1.26.4 && \
    mise install ruby@3.3.6 && \
    mise install node@24.11.1 && \
    mise install node@20.11.1 && \
    mise install pnpm@10.24.0 && \
    mise install yarn@1.22.19

# グローバルデフォルトを設定
RUN mise use --global go@1.26.4 && \
    mise use --global ruby@3.3.6 && \
    mise use --global node@24.11.1 && \
    mise use --global pnpm@10.24.0

# --- dbmate ---
ARG DBMATE_VERSION=v2.33.0
ARG DBMATE_SHA256=dfd4027141b6e4357158099bdfe6c02b286af70f8e49057937744cf80b38ea1c
RUN curl -fsSL -o /tmp/dbmate \
      https://github.com/amacneil/dbmate/releases/download/${DBMATE_VERSION}/dbmate-linux-amd64 && \
    echo "${DBMATE_SHA256}  /tmp/dbmate" | sha256sum -c - && \
    mv /tmp/dbmate /usr/local/bin/dbmate && \
    chmod +x /usr/local/bin/dbmate

# --- hivemind ---
ARG HIVEMIND_VERSION=v1.1.0
ARG HIVEMIND_SHA256=809ca1c5fedbbfca8fdfb3a4b9bb9c41868b046f35f85a3e893ccf2583a3921a
RUN curl -fsSL -o /tmp/hivemind.gz \
      https://github.com/DarthSim/hivemind/releases/download/${HIVEMIND_VERSION}/hivemind-${HIVEMIND_VERSION}-linux-amd64.gz && \
    echo "${HIVEMIND_SHA256}  /tmp/hivemind.gz" | sha256sum -c - && \
    gunzip /tmp/hivemind.gz && \
    mv /tmp/hivemind /usr/local/bin/hivemind && \
    chmod +x /usr/local/bin/hivemind

# --- golangci-lint ---
ARG GOLANGCI_LINT_VERSION=2.11.4
ARG GOLANGCI_LINT_SHA256=200c5b7503f67b59a6743ccf32133026c174e272b930ee79aa2aa6f37aca7ef1
RUN curl -fsSL -o /tmp/golangci-lint.tar.gz \
      https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64.tar.gz && \
    echo "${GOLANGCI_LINT_SHA256}  /tmp/golangci-lint.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/golangci-lint.tar.gz -C /tmp && \
    mv /tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64/golangci-lint /usr/local/bin/golangci-lint && \
    chmod +x /usr/local/bin/golangci-lint && \
    rm -rf /tmp/golangci-lint.tar.gz /tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64

# --- GitHub CLI ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt update && apt install -y gh

# --- ユーザー設定 ---
RUN groupadd -g ${GROUP_ID} ${USERNAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/zsh ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- Goのキャッシュディレクトリ ---
RUN mkdir -p /go/.cache/go-build /go/pkg && \
    chown -R ${USER_ID}:${GROUP_ID} /go

# --- miseのデータディレクトリの権限設定 ---
RUN chown -R ${USER_ID}:${GROUP_ID} /mise

# --- 1Password CLIの設定ディレクトリ ---
# 名前付きボリュームop-configをここにマウントする。Dockerがイメージ側の
# 所有権を引き継ぐのはボリュームが空で新規作成されたときだけのため、`op` が設定を
# 書き込めるよう開発者ユーザー所有のディレクトリを事前に用意しておく。
RUN install -d -o ${USER_ID} -g ${GROUP_ID} /home/${USERNAME}/.config && \
    install -d -o ${USER_ID} -g ${GROUP_ID} -m 0700 /home/${USERNAME}/.config/op

WORKDIR /workspace
USER ${USERNAME}

# --- .zshrcの作成 ---
RUN touch ~/.zshrc

# --- miseシェル設定 ---
# Docker環境ではshims方式を使用 (PATH="/mise/shims:..." で設定済み)。
# mise activateはshimsをバイパスしてグローバルデフォルトの直接パスをPATHに
# 追加するため、ディレクトリごとのバージョン切り替えが効かなくなる。shims方式では不要。
RUN mise reshim

# --- 1Password CLI ---
COPY --from=1password/op:2 /usr/local/bin/op /usr/local/bin/op

# --- Claude Code ---
RUN curl -fsSL https://claude.ai/install.sh | bash

# --- Codex ---
RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

# --- Goツール ---
ENV GOCACHE=/go/.cache/go-build
ENV GOMODCACHE=/go/pkg/mod
ENV GOPATH=/go
ENV PATH="${GOPATH}/bin:${PATH}"
RUN go install github.com/air-verse/air@latest

# --- Rubyツール ---
RUN gem install bundler -v 2.5.9

# --- Playwright CLI (ブラウザ確認) ---
# monorepoでmiseが選ぶ全Nodeバージョン (/workspaceと /workspace/goは24.11.1、
# /workspace/railsは20.11.1) に @playwright/cliをinstallし、どのディレクトリからでも
# shimが解決できるようにする。その後 --with-depsでChromium本体とsystem依存を焼き込む
# (MewstはPlaywrightのブラウザもsystem依存も未導入のため)。
RUN mise exec node@24.11.1 -- npm install -g @playwright/cli@0.1.17 && \
    mise exec node@20.11.1 -- npm install -g @playwright/cli@0.1.17 && \
    mise reshim && \
    playwright-cli install-browser chromium --with-deps

# --- シェル設定 ---
SHELL ["/bin/zsh", "-c"]
ENV SHELL=/bin/zsh

# --- Git設定 ---
RUN git config --global user.email "me@shimba.co" && \
    git config --global user.name "Koji Shimba"

EXPOSE 8080 3000

CMD ["/bin/zsh"]
